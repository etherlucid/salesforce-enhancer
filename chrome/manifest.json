{
  "manifest_version": 3,
  "name": "Salesforce Enhancer",
  "version": "1.1.0",
  "description": "Salesforce productivity: subtabs & tab drag-and-drop, Quick Views list bookmarking, developer themes, and custom animations.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.lightning.force.com/*",
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.visualforce.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.salesforce-communities.com/*",
    "https://*.site.com/*",
    "https://*.cloudforce.com/*",
    "https://*.salesforce-experience.com/*",
    "https://*.my.salesforce.com/*",
    "https://*.my.site.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Salesforce Enhancer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.salesforce.com/*",
        "https://*.force.com/*",
        "https://*.visualforce.com/*",
        "https://*.salesforce-setup.com/*",
        "https://*.salesforce-communities.com/*",
        "https://*.site.com/*",
        "https://*.cloudforce.com/*",
        "https://*.salesforce-experience.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.my.site.com/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "css": ["loading-intercept.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.salesforce.com/*",
        "https://*.force.com/*",
        "https://*.visualforce.com/*",
        "https://*.salesforce-setup.com/*",
        "https://*.salesforce-communities.com/*",
        "https://*.site.com/*",
        "https://*.cloudforce.com/*",
        "https://*.salesforce-experience.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.my.site.com/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": ["page-script.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-script.js",
        "uploader.html",
        "uploader.js",
        "parrot.gif",
        "nyan.gif",
        "icons/icon-32.png",
        "icons/icon-48.png",
        "icons/icon-128.png"
      ],
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.salesforce.com/*",
        "https://*.force.com/*",
        "https://*.visualforce.com/*",
        "https://*.salesforce-setup.com/*",
        "https://*.salesforce-communities.com/*",
        "https://*.site.com/*",
        "https://*.cloudforce.com/*",
        "https://*.salesforce-experience.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.my.site.com/*"
      ]
    }
  ]
}
